# Telegram API credentials (required)
# Get from https://my.telegram.org
API_ID=
API_HASH=

# Pyrogram session string (required)
SESSION_STR=

# Bot token from @BotFather (required for inline/bot features)
BOT_TOKEN=

# AI gateway API key (optional, powers the agentic .ask command)
AI_API_KEY=
# Base URL of your Anthropic-compatible gateway, e.g. https://api.example.com
# Required alongside AI_API_KEY — the AI features stay off until both are set.
AI_BASE_URL=
AGENT_MODEL=claude-opus-4-8
AGENT_VISION_MODEL=claude-opus-4-8

# Let the agent run shell commands (default false).
# Leave this off unless you trust every message you .ask about: replied-to text
# is included in the prompt, so enabling it turns other people's messages into
# a path to command execution.
AGENT_ALLOW_SHELL=false

# Let the agent ban, kick, mute, promote, and delete/pin messages (default false).
# Same hazard as the shell tool: text from other people's messages reaches the
# prompt, so enabling this turns it into a way to get members removed. The tools
# still refuse the chat owner, other admins, and the userbot itself, and cap each
# .ask run at 10 actions — but leave this off unless you want the agent moderating.
AGENT_ALLOW_MODERATION=false

# Let the agent call ANY Telegram client method, not just the moderation subset
# (default false). This SUPERSEDES the moderation guards rather than extending
# them: a raw ban_chat_member call goes around the owner/admin/self refusals and
# the per-run action cap, and it can reach any chat the account is in, not only
# the one .ask ran in. Session-, login-, lifecycle-, and host-file methods stay
# blocked regardless. Enable only where you would hand the same person the account.
AGENT_ALLOW_TELEGRAM_API=false

# Auto-select the cheapest model the gateway advertises (default false)
AGENT_USE_CHEAPEST_MODEL=false

# YT_DLP API key (optional, for YouTube downloads)
YT_DLP_API_KEY=
# Optional: Base URL for the YT_DLP API
YT_DLP_BASE_URL=https://api.nubcoders.com

# Support group username without @ (optional)
GROUP=nub_coder_s

# Updates channel username without @ (optional)
CHANNEL=nub_coders

# MongoDB URI (optional — leave empty to use in-memory storage, lost on restart)
MONGO_URI=

# MongoDB database name (optional, defaults to "userbot")
DB_NAME=userbot
